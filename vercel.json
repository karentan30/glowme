{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/pay/create",   "destination": "/api/pay/create.js" },
    { "source": "/api/pay/status",   "destination": "/api/pay/status.js" },
    { "source": "/api/pay/callback", "destination": "/api/pay/callback.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
